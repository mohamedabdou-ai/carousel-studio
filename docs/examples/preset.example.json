{
  "schemaVersion": 1,
  "id": "swiss",
  "version": "1.0",
  "name": {
    "ar": "سويس",
    "en": "Swiss"
  },
  "description": {
    "ar": "خطوط ثقيلة على خلفية فاتحة وتشديد بلون واحد",
    "en": "Heavy type, one accent"
  },
  "bestFor": [
    "hot takes",
    "lists"
  ],
  "ships": "1.0",
  "paintable": true,
  "roles": {
    "bg": "#F4F4F2",
    "surface": "#FFFFFF",
    "ink": "#111111",
    "inkMuted": "#5A5A5A",
    "accent": "#E3262B"
  },
  "brandBindings": [
    "bg",
    "ink",
    "accent",
    "fonts"
  ],
  "type": {
    "display": {
      "family": "ibm-plex-sans-arabic",
      "wght": 700,
      "lh": 1.3
    },
    "heading": {
      "family": "ibm-plex-sans-arabic",
      "wght": 700,
      "lh": 1.35
    },
    "body": {
      "family": "readex-pro",
      "wght": 400,
      "lh": 1.6
    },
    "latin": {
      "family": "ibm-plex-sans",
      "wght": 700
    },
    "scale": {
      "hero": [
        120,
        180
      ],
      "heroTarget": 150,
      "h1": 88,
      "h2": 72,
      "title": [
        64,
        72
      ],
      "body": [
        44,
        48
      ],
      "small": 34,
      "micro": 30
    }
  },
  "layout": {
    "align": "start",
    "coverAnchor": "top",
    "headlineWidth": [
      0.65,
      0.85
    ]
  },
  "background": {
    "kind": "solid",
    "params": {
      "role": "bg"
    }
  },
  "decor": {
    "highlight": "bar",
    "numbering": "ghost",
    "texture": "none",
    "kashida": {
      "allowed": false
    }
  },
  "chrome": {
    "handle": {
      "slot": "header-start"
    },
    "meta": {
      "slot": "header-end"
    },
    "counter": {
      "slot": "footer-center",
      "format": "{i} من {n}"
    },
    "swipe": {
      "slot": "footer-end",
      "style": "label+chevron"
    },
    "savePill": {
      "slot": "footer-start",
      "showOn": [
        "cover",
        "cta"
      ]
    }
  },
  "variants": {
    "cover": [
      "top",
      "center"
    ],
    "item": [
      "ghost-number",
      "base"
    ]
  },
  "motion": {
    "default": "calm",
    "allowed": [
      "calm",
      "counter",
      "highlight-sweep",
      "stamp"
    ]
  },
  "floors": {
    "hero": 96,
    "body": 42,
    "meta": 30,
    "contrastBody": 4.5,
    "contrastLarge": 3.0
  },
  "art": {
    "stroke": 2.0,
    "cap": "butt",
    "join": "miter",
    "container": "square",
    "radius": {
      "chip": 0,
      "tile": 0,
      "card": 0,
      "panel": 0,
      "window": 0
    },
    "shadow": {
      "kind": "none"
    },
    "outline": 0,
    "objectOutline": 0.035,
    "outlineColor": "ink",
    "fill": "flat",
    "wobble": 0,
    "tilt": 0,
    "texture": "none",
    "doodle": "geometric",
    "colors": {
      "note": "#FFE88A",
      "support": [
        "#1D4ED8",
        "#0F766E"
      ]
    },
    "mark": "fill",
    "hand": null,
    "chipOffset": 0,
    "templates": [
      "sheet",
      "staircase",
      "versus"
    ],
    "affinity": {
      "icon": 0.5,
      "scene": 0.3,
      "rows": 0.7,
      "numeral": 0.9,
      "chart": 0.8,
      "mock": 0.4,
      "photo": 0.4,
      "field": 0.9,
      "word": 0.8,
      "pattern": 0.2
    },
    "marks": [
      "rule",
      "arrow-square",
      "bracket",
      "tick"
    ],
    "rail": {
      "style": "bars"
    },
    "thread": {
      "style": "ruler",
      "extends": "footer-rule"
    },
    "motif": "header-tab"
  },
  "tones": {
    "invert": {
      "roles": {
        "bg": "ink",
        "surface": {
          "mix": [
            "ink",
            "bg",
            0.03
          ]
        },
        "ink": "bg",
        "inkMuted": {
          "muted": 4.7
        },
        "accent": "accent"
      }
    },
    "field": {
      "roles": {
        "bg": "accent",
        "surface": {
          "mix": [
            "accent",
            "ink",
            0.3
          ]
        },
        "ink": "surface",
        "inkMuted": "surface",
        "accent": {
          "pick": [
            [
              "ink",
              "surface"
            ],
            3.0
          ]
        }
      }
    }
  }
}
