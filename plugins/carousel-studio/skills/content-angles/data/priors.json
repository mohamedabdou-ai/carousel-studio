{
  "schemaVersion": 1,
  "dataVersion": "1.0.0",
  "description": "Seed priors for scoring angles (content-angles) and, through the hook library, hook families. First-party numbers come from one reference account (an Arabic AI and business creator writing Egyptian dialect, May to October 2026); they are correlational and the samples are small. A brand's own hooks.familyPriors with n >= 5 replace the seed for that family. Scores are model parameters derived by the stated method, not measurements.",
  "method": {
    "lift": "value / baseline, both medians of the same metric",
    "tiers": {
      "A": {
        "minLift": 2.0,
        "score": 85
      },
      "B": {
        "minLift": 1.5,
        "score": 70
      },
      "C": {
        "minLift": 0.8,
        "score": 50
      },
      "D": {
        "minLift": 0.0,
        "score": 25
      }
    },
    "neutralScore": 50,
    "minSample": 5,
    "rules": [
      "Only first-party (D-own) evidence with n >= minSample sets a tier; anything thinner stays neutral and is shown as a hint.",
      "A lens score is the best score among its families for the intent; no family is credited for evidence on another intent.",
      "Evidence rank when sources disagree: D-own > D > O > EC > SE."
    ],
    "tags": {
      "D-own": "first-party account insights",
      "D": "published data or peer-reviewed study",
      "O": "platform statement",
      "EC": "three or more practitioners agree",
      "SE": "single expert"
    }
  },
