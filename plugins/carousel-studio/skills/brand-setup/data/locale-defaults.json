{
  "schemaVersion": 1,
  "dataVersion": "1.0.0",
  "description": "Per-dialect and per-country defaults used at onboarding (brand-setup), by carousel-create (dialect, digits, swipe cue) and by CS.core (punctuation, counter). Digits default to Western 0-9 everywhere (Q38: 100% of numerals on the winning Arabic covers were Western); Arabic-Indic is an opt-in that the plugin only OFFERS for formal registers. Swipe cue follows the audience's Instagram app language (Q24).",
  "digits": {
    "default": "western",
    "optIn": "arabic-indic",
    "offerArabicIndicWhen": {
      "register": [
        "msa"
      ],
      "topics": [
        "government",
        "finance",
        "health",
        "legal"
      ],
      "countries": [
        "EG",
        "SA",
        "IQ",
        "SD",
        "YE"
      ]
    },
    "evidence": {
      "ar": "كل الأرقام على أغلفة الكاروسيل العربي الناجحة اللي حلّلناها (16 غلاف) كانت بالأرقام 123.",
      "en": "Every numeral on the 16 winning Arabic covers we analysed was Western (0-9)."
    },
    "rule": "One digit system per design. Conversion happens in one pass and never inside handles, hashtags, URLs or phone numbers.",
    "systems": {
      "western": {
        "digits": "0123456789",
        "decimal": ".",
        "thousands": ",",
        "percent": "%",
        "counterExample": "3 من 8"
      },
      "arabic-indic": {
        "digits": "٠١٢٣٤٥٦٧٨٩",
        "decimal": "٫",
        "thousands": "٬",
        "percent": "٪",
        "counterExample": "٣ من ٨"
      }
    },
    "forbiddenDigitForms": [
      "۰۱۲۳۴۵۶۷۸۹ (Persian / Extended Arabic-Indic U+06F0-06F9)"
    ]
  },
  "swipeCue": {
    "verification": "Web-verified on 2026-10-21 (Arabic UI puts slide 2 on the LEFT); native phone apps not device-tested (SP8); the cue is a per-brand setting, so it is right either way.",
    "byAppLanguage": {
      "ar": "arrow-rtl",
      "en": "arrow-ltr",
      "mixed": "neutral"
    },
    "meaning": {
      "arrow-rtl": "Arabic-UI audience: the next slide is on the left, so the cue points left.",
      "arrow-ltr": "English-UI audience: the next slide is on the right, so the cue points right.",
      "neutral": "Mixed audience: no arrow; the counter plus a quiet progress rail."
    },
    "labels": {
      "arrow-rtl": {
        "eg": "اسحب ←",
        "gulf": "اسحب ←",
        "levant": "اسحب ←",
        "msa-white": "اسحب ←",
        "en": "Swipe ←"
      },
      "arrow-ltr": {
        "eg": "اسحب →",
        "gulf": "اسحب →",
        "levant": "اسحب →",
        "msa-white": "اسحب →",
        "en": "Swipe →"
      },
      "neutral": {
        "eg": "التالي",
        "gulf": "التالي",
        "levant": "التالي",
        "msa-white": "التالي",
        "en": "Next"
      }
    },
    "panoramas": "opt-in only, with an explicit direction chosen by the user"
  },
  "counter": {
    "formats": {
      "ar": "{i} من {n}",
      "en": "{i}/{n}"
    },
    "remainingFormat": {
      "ar": "باقي {k}",
      "en": "{k} left"
    },
    "remainingFromSlideCount": 2,
    "digitsFollow": "locale.digits"
  },
  "slideStrings": {
    "_note": "Text the ENGINE prints on slides (it follows the post's dialect, not the Studio UI dialect). {i} {n} {k} are numbers formatted in locale.digits. Labels of compare and myth-fact sides come from slide.sides[].label; mythLabel/factLabel/versusLabel are the defaults when a label is empty.",
    "savePill": {
      "eg": "احفظ البوست",
      "gulf": "احفظ البوست",
      "levant": "احفظ البوست",
      "msa-white": "احفظ المنشور",
      "en": "Save this post"
    },
    "stepLabel": {
      "eg": "الخطوة {i} من {n}",
      "gulf": "الخطوة {i} من {n}",
      "levant": "الخطوة {i} من {n}",
      "msa-white": "الخطوة {i} من {n}",
      "en": "Step {i} of {n}"
    },
    "mythLabel": {
      "eg": "خرافة",
      "gulf": "خرافة",
      "levant": "خرافة",
      "msa-white": "خرافة",
      "en": "Myth"
    },
    "factLabel": {
      "eg": "حقيقة",
      "gulf": "حقيقة",
      "levant": "حقيقة",
      "msa-white": "حقيقة",
      "en": "Fact"
    },
    "versusLabel": {
      "eg": "مقابل",
      "gulf": "مقابل",
      "levant": "مقابل",
      "msa-white": "مقابل",
      "en": "VS"
    }
  },
  "punctuation": {
    "ar": {
      "comma": "،",
      "semicolon": "؛",
      "question": "؟",
      "ellipsis": "…",
      "quotes": [
        "«",
        "»"
      ],
      "percent": {
        "western": "%",
        "arabic-indic": "٪"
      },
      "decimal": {
        "western": ".",
        "arabic-indic": "٫"
      },
      "thousands": {
        "western": ",",
        "arabic-indic": "٬"
      },
      "spacing": "No space before ، ؛ ؟ : ! . and one space after. No Latin punctuation (, ; ?) inside Arabic sentences.",
      "bidi": "Isolate every LTR run with <bdi dir=\"ltr\">; never insert U+200E/U+200F by hand in stored copy."
    },
    "en": {
      "comma": ",",
      "semicolon": ";",
      "question": "?",
      "ellipsis": "…",
      "quotes": [
        "“",
        "”"
      ]
    }
  },
  "register": {
    "defaults": {
      "eg": "dialect",
      "gulf": "dialect",
      "levant": "dialect",
      "msa-white": "white",
      "en": "white"
    },
    "suggestMsaFor": [
      "government",
      "finance",
      "health",
      "legal",
      "education-formal"
    ],
    "suggestWhiteFor": [
      "pan-arab ads",
      "instructions",
      "reference posts",
      "mixed-country audiences"
    ],
    "suggestDialectFor": [
      "personal brands",
      "stories",
      "opinions",
      "local pull"
    ],
    "rule": "One register per post. Latin brand and tool names stay Latin."
  },
  "dialects": {
    "eg": {
      "label": {
        "ar": "مصري",
        "en": "Egyptian"
      },
      "register": "dialect",
      "uiDialect": "eg",
      "countries": [
        "EG"
      ],
      "subVarieties": [],
      "counter": "ar",
      "ctaStyle": "direct",
      "note": "Most widely understood dialect. Deny markers for other dialects live in dialects/eg.json."
    },
    "gulf": {
      "label": {
        "ar": "خليجي",
        "en": "Gulf"
      },
      "register": "dialect",
      "uiDialect": "gulf",
      "countries": [
        "SA",
        "AE",
        "KW",
        "QA",
        "BH",
        "OM"
      ],
      "subVarieties": [
        "najdi",
        "hijazi",
        "emirati"
      ],
      "counter": "ar",
      "ctaStyle": "soft",
      "note": "White Gulf (understood across the GCC) plus English tool names. Sub-variety is a brand setting: Najdi 'أبي', Hijazi 'أبغى'."
    },
    "levant": {
      "label": {
        "ar": "شامي",
        "en": "Levantine"
      },
      "register": "dialect",
      "uiDialect": "levant",
