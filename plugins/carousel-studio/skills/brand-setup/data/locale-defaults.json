        "LB",
        "SY",
        "JO",
        "PS"
      ],
      "subVarieties": [
        "lebanese",
        "syrian"
      ],
      "counter": "ar",
      "ctaStyle": "soft",
      "note": "Sub-variety is a brand setting: Lebanese 'هيدا', Syrian 'هاد'."
    },
    "msa-white": {
      "label": {
        "ar": "فصحى مبسّطة",
        "en": "Simplified MSA"
      },
      "register": "white",
      "uiDialect": "msa-white",
      "countries": [
        "IQ",
        "YE",
        "SD",
        "LY",
        "TN",
        "DZ",
        "MA",
        "MR"
      ],
      "subVarieties": [],
      "counter": "ar",
      "ctaStyle": "neutral",
      "note": "Default for Iraq, Yemen, Sudan and the Maghreb until a native Darija pack exists (post-v1). Also the pan-Arab choice."
    },
    "en": {
      "label": {
        "ar": "English",
        "en": "English"
      },
      "register": "white",
      "uiDialect": "en",
      "countries": [],
      "subVarieties": [],
      "counter": "en",
      "ctaStyle": "direct",
      "note": "English copy: dir=ltr lang=en. The Studio chrome follows the audience app language."
    }
  },
