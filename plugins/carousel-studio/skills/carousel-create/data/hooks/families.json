    {"id": "CTA-send-recipient", "kind": "send", "intents": ["send", "reach"], "fits": ["myth-fact", "opinion", "story", "framework"], "name": {"ar": "ابعته للي…", "en": "Send it to the one who…"}, "skeleton": {"eg": "ابعته لصاحبك اللي {trait}", "gulf": "أرسله لصاحبك اللي {trait}", "levant": "ابعته لصاحبك اللي {trait}", "msa-white": "أرسله إلى صديقك الذي {trait}", "en": "Send this to the friend who {trait}"}, "slots": {"trait": {"type": "clause", "maxWords": 4, "rule": "a recognisable habit or situation that this post speaks to"}}, "maxWords": 12, "requires": [], "lints": ["no-comment-bait"], "note": "Names a recipient and a trait. Sends per reach is a top ranking signal; a bare \"share this\" counts as bait.", "examples": [{"text": "ابعته لصاحبك اللي دايما بيأجل", "dialect": "eg", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "أرسله لصاحبك اللي دايم يأجل", "dialect": "gulf", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "ابعته لصاحبك اللي دايما بيأجل", "dialect": "levant", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "أرسله إلى صديقك الذي يؤجل دائما", "dialect": "msa-white", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "Send this to the friend who always puts things off", "dialect": "en", "origin": "synthetic", "visibility": "public"}]},
