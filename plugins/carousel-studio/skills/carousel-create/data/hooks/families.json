    {"id": "CTA-send-reason", "kind": "send", "intents": ["send", "reach"], "fits": ["listicle", "steps", "news", "lead-magnet"], "name": {"ar": "ابعته لـ… عشان…", "en": "Send it to… so that…"}, "skeleton": {"eg": "ابعته لأي حد {who} عشان {reason}", "gulf": "أرسله لأي أحد {who} عشان {reason}", "levant": "ابعته لأي حدا {who} ل{reason}", "msa-white": "أرسله إلى كل من {who} ل{reason}", "en": "Send it to anyone {who} so they {reason}"}, "slots": {"who": {"type": "clause", "maxWords": 3, "rule": "who it helps"}, "reason": {"type": "verb-phrase", "maxWords": 3, "rule": "what they gain"}}, "maxWords": 12, "requires": [], "lints": ["no-comment-bait"], "note": "Gives both a recipient and a reason, so sending feels like a favour rather than a request.", "examples": [{"text": "ابعته لأي حد لسه بيبدأ عشان يوفر وقت", "dialect": "eg", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "أرسله لأي أحد توه يبدأ عشان يوفر وقت", "dialect": "gulf", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "ابعته لأي حدا لسا بلش ليوفر وقت", "dialect": "levant", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "أرسله إلى كل من يبدأ حديثا ليوفر وقته", "dialect": "msa-white", "origin": "synthetic", "visibility": "public", "nativeReviewed": false}, {"text": "Send it to anyone just starting so they save time", "dialect": "en", "origin": "synthetic", "visibility": "public"}]},
