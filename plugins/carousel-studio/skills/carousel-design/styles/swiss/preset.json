{
  "schemaVersion": 1,
  "id": "swiss",
  "version": "1.0",
  "name": {
    "ar": "سويس",
    "en": "Swiss"
  },
  "description": {
    "ar": "خط ثقيل على خلفية فاتحة، وشبكة صارمة، ولون تشديد واحد للكلمة أو الرقم الأهم.",
    "en": "Heavy type on a light field, a strict grid and a single accent for the keyword or the number."
  },
  "bestFor": [
    "hot takes",
    "lists",
    "opinion",
    "marketing and design"
  ],
  "ships": "1.2",
  "paintable": true,
  "roles": {
    "bg": "#F4F4F2",
    "surface": "#FFFFFF",
    "ink": "#111111",
    "inkMuted": "#5A5A5A",
    "accent": "#E3262B"
  },
  "brandBindings": [
    "bg",
    "surface",
    "ink",
    "inkMuted",
    "accent",
    "fonts"
  ],
  "type": {
    "display": {
      "family": "ibm-plex-sans-arabic",
      "wght": 700,
      "lh": 1.3
    },
    "heading": {
      "family": "ibm-plex-sans-arabic",
      "wght": 700,
      "lh": 1.35
    },
    "body": {
      "family": "readex-pro",
      "wght": 400,
      "lh": 1.6
    },
    "latin": {
      "family": "ibm-plex-sans",
      "wght": 700
    },
    "scale": {
      "hero": [
        120,
        180
      ],
      "heroTarget": 150,
      "h1": 88,
      "h2": 72,
      "title": [
        64,
        72
      ],
      "body": [
        44,
        48
      ],
      "small": 34,
      "micro": 30
    }
  },
  "layout": {
    "align": "start",
    "coverAnchor": "top",
    "headlineWidth": [
      0.65,
      0.85
    ]
  },
  "background": {
    "kind": "solid",
    "params": {
      "role": "bg"
    }
  },
  "decor": {
    "highlight": "bar",
    "numbering": "ghost",
    "texture": "none",
    "kashida": {
      "allowed": false
    }
  },
  "chrome": {
    "handle": {
      "slot": "header-start",
      "logo": "auto"
    },
    "meta": {
      "slot": "header-end"
    },
    "counter": {
      "slot": "footer-center",
      "format": "{i} من {n}"
    },
    "swipe": {
      "slot": "footer-end",
      "style": "label+chevron"
    },
    "savePill": {
      "slot": "footer-start",
      "showOn": [
        "cta"
      ]
    }
  },
  "variants": {
    "cover": [
      "top",
      "number",
      "center"
    ],
    "rehook": [
      "base",
      "big-number"
    ],
    "item": [
      "ghost-number",
      "base",
      "side-number"
    ],
    "step": [
      "ghost-number",
      "base",
      "pill"
    ],
    "stat": [
      "bar",
      "base"
    ],
    "compare": [
      "columns",
      "versus",
      "stacked"
    ],
    "myth-fact": [
      "columns",
      "stacked"
    ],
    "quote": [
      "mark",
      "base"
    ],
    "story-beat": [
      "base",
      "panel"
    ],
    "checklist": [
      "ruled",
      "base",
      "boxes"
    ],
    "summary": [
      "list",
      "grid"
    ],
    "setup": [
      "base",
      "cards"
    ],
    "proof": [
      "screenshot",
      "base"
    ],
    "share": [
      "big-word",
      "base"
    ],
    "cta": [
      "pill",
      "base",
      "keyword"
    ],
    "offer": [
      "base",
      "card"
    ],
    "testimonial": [
      "base",
      "card"
    ],
    "poster": [
      "top",
      "center"
    ],
    "grid": [
      "bento"
    ],
    "timeline": [
      "rail"
    ]
  },
  "motion": {
    "default": "highlight-sweep",
    "allowed": [
      "calm",
      "counter",
      "highlight-sweep",
      "reorder",
      "stamp",
      "map-dots",
      "drop-clock",
      "curtain",
      "zoom",
      "notify",
      "split"
    ]
  },
  "floors": {
    "hero": 96,
    "body": 42,
    "meta": 30,
    "contrastBody": 4.5,
    "contrastLarge": 3.0
  }
}
