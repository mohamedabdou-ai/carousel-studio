  "description": {
    "ar": "لوحات توضيحية مطبوعة: ورق كريمي بإطار واحد وعلامات قص في الأركان، وعنوان أخضر داكن، وختم ولوحات برقم شكل. للمقارنات والأرقام.",
    "en": "A printed specimen sheet: cream paper in one frame with crop marks, a deep-green headline, plates with figure tabs, rust stamps and ledgers. Built for comparisons and numbers."
  },
  "bestFor": [
    "x vs y",
    "numbers",
    "health and nutrition",
    "finance comparisons",
    "infographics"
  ],
  "ships": "1.0",
