{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:carousel-studio:schema:occasion:1",
  "title": "Carousel Studio occasion pack",
  "description": "occasions/<id>/pack.json. Data only: a pack may only set the overlay keys the runtime already understands.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,47}$",
      "description": "e.g. ramadan-2027."
    },
    "kind": {
      "type": "string",
      "enum": [
        "religious",
        "national",
        "commercial"
      ]
    },
    "names": {
      "type": "object",
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "ar",
        "en"
      ],
      "additionalProperties": false
    },
    "minPluginVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "start": {
            "$ref": "#/$defs/isoDate"
          },
          "end": {
            "$ref": "#/$defs/isoDate"
          },
          "rule": {
            "type": "string",
            "enum": [
              "fixed",
              "hijri",
              "nth-weekday"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "exact",
              "±1d"
            ]
          }
        },
        "required": [
          "country",
          "start",
          "end",
          "rule",
          "confidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 24
    },
    "windows": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "integer",
          "maximum": 0
        },
        "pre": {
          "type": "integer",
          "maximum": 0
        },
        "post": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "plan",
        "pre",
        "post"
      ],
      "additionalProperties": false,
      "description": "Days relative to the start date (plan = when planning should begin)."
    },
    "overlay": {
      "type": "object",
      "properties": {
        "allowedKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "roles.accent2",
              "background.texture",
              "decor.motif"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]*\\.svg$",
            "maxLength": 120
          },
          "maxItems": 12
        },
        "presetsAllowed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/presetSlug"
          },
          "maxItems": 12
        }
      },
      "required": [
        "allowedKeys",
        "tokens"
      ],
      "additionalProperties": false
    },
    "copyKit": {
      "type": "object",
      "properties": {
        "greetings": {
          "type": "object",
          "properties": {
            "eg": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 8
            },
            "gulf": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 8
            },
            "levant": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 8
            },
            "msa-white": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 8
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 120
              },
              "maxItems": 8
            }
          },
          "additionalProperties": false
        },
        "seedAngles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 20
        },
        "ctaNotes": {
          "type": "string",
          "maxLength": 400
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "shift": {
          "type": "string",
          "enum": [
            "none",
            "after-iftar",
            "evening"
          ]
        }
      },
      "additionalProperties": false
    },
    "sensitivities": {
      "type": "object",
      "properties": {
        "noQuranOnPromo": {
          "type": "boolean"
        },
        "noShahada": {
          "type": "boolean"
        },
        "noSaudiFlagOnPromo": {
          "type": "boolean"
        },
        "noKaabaForSelling": {
          "type": "boolean"
        },
        "noDisputedMaps": {
          "type": "boolean"
        },
        "term": {
          "type": "string",
          "maxLength": 60
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "names",
    "minPluginVersion",
    "dates",
    "windows",
    "overlay",
    "sensitivities"
  ],
  "additionalProperties": false,
  "x-sharedDefs": [
    "isoDate",
    "presetSlug"
  ],
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "presetSlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    }
  }
}
