{
  "schemaVersion": 1,
  "id": "heritage",
  "version": "1.0",
  "name": { "ar": "تراثي", "en": "Heritage" },
  "description": { "ar": "لون عميق وزخرفة هندسية وذهب", "en": "Deep colour, geometry and gold" },
  "bestFor": ["culture"],
  "ships": "1.0",
  "paintable": true,
  "roles": { "bg": "#16473A", "surface": "#1C5645", "ink": "#F7F1E3", "inkMuted": "#CFC7B4", "accent": "#E8B05C" },
  "brandBindings": ["accent", "fonts"],
  "type": {
    "display": { "family": "alexandria", "wght": 800, "lh": 1.3 },
    "heading": { "family": "alexandria", "wght": 700, "lh": 1.35 },
    "body": { "family": "readex-pro", "wght": 400, "lh": 1.6 },
    "latin": { "family": "readex-pro", "wght": 600 },
    "scale": { "hero": [120, 170], "heroTarget": 144, "h1": 84, "h2": 68, "title": [60, 68], "body": [44, 48], "small": 34, "micro": 30 }
  },
  "layout": { "align": "center", "coverAnchor": "center", "headlineWidth": [0.7, 0.85] },
  "background": { "kind": "gradient", "params": { "angle": 160, "stops": [["bg", 0], ["#0F362C", 100]] } },
  "decor": { "highlight": "color", "numbering": "plain", "texture": "pattern", "kashida": { "allowed": true } },
  "chrome": {
    "handle": { "slot": "header-start", "logo": "auto" },
    "meta": { "slot": "header-end" },
    "counter": { "slot": "footer-center", "format": "{i}/{n}" },
    "swipe": { "slot": "footer-end", "style": "label+chevron" },
    "savePill": { "slot": "footer-start", "showOn": ["cover", "cta"] }
  },
  "variants": { "cover": ["center", "top"], "item": ["base", "ghost-number"], "cta": ["base"] },
  "motion": { "default": "calm", "allowed": ["calm", "stamp"] },
  "floors": { "hero": 96, "body": 42, "meta": 30, "contrastBody": 4.5, "contrastLarge": 3.0 }
}
