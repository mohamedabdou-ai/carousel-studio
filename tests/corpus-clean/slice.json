{
 "schemaVersion": 1,
 "description": "Clean slice decks (round 3, package Q7a; build plan r2 3.2). Each deck is a zero-override fixture of tests/fixtures/auto (base, with #n picking one spec of the array) plus a stored plan: the visual objects the V2 planner writes with plan.mjs --save-plan, kept wherever the real engine draws that slide cleanly and replaced by a hand-picked anchor where the zero-override pick did not (the replaced picks are the AUTO floor, which ACC judges and node tests/corpus-bad/rendered.mjs --floor lists; this corpus asks only whether the gates raise a false alarm on slides that are fine). The text gates run these decks in both engines (run.mjs, run.py: no BLOCK and no FIX); rendered.mjs renders them with the real engine in Chromium and runs every rendered gate too. requireExecuted names the gates of build plan r2 3.1: each must have run at least once over the decks, because a gate that never ran proves nothing. Fields: id, base, brand, preset (creator or poster), note, fonts, patch (RFC 6902 on the base spec). `fonts` is written by hand: the registry id the Studio resolves for display, heading, body and latin, because both presets bind the fonts role and so the brand's own fonts win over the preset's (build_studio.py embeds them, resolve.js applyBrand applies them). rendered.mjs embeds the fonts of every brand it renders and fails when the resolved family of any slide differs from this list, or when a resolved face did not load. The deck ids are a fixed list held in fixed.mjs and run.py.",
 "requireExecuted": [
  "D9.band",
  "D9.rect",
  "D9.fill",
  "D9.container-fill",
  "VA1.anchor-present",
  "VA2.anchor-size",
  "VA3.valid",
  "VA4.chart-honesty",
  "VA6.pause",
  "VA7.agreement",
  "VA8.constraints",
  "D8.anchor-run",
  "D8.tone-run",
  "D10.nesting",
  "D10.icon-tile-stack",
  "D10.stroke-feed",
  "D10.art-label",
  "D10.glyph-icon",
  "C2.body-with-art",
  "C2.demo-words",
  "C2.demo-missing",
  "C2.demo-duplicate",
  "C2.figure-repeat"
 ],
